{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc-x64",
      "displayName": "Visual Studio x64 (newest installed)",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "msvc-x64-ci",
      "inherits": "msvc-x64",
      "displayName": "Visual Studio x64 (warnings as errors)",
      "cacheVariables": { "PERIODIC_CALLER_WARNINGS_AS_ERRORS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "msvc-x64", "configuration": "Debug" },
    { "name": "release", "configurePreset": "msvc-x64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "msvc-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "msvc-x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
